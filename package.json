{
  "name": "memory-game",
  "version": "1.0.0",
  "type": "module",
  "description": "Memory card matching game",
  "scripts": {
    "serve": "npx http-server src -p 3000 -c-1",
    "test": "mocha",
    "test:watch": "mocha --watch",
    "test:coverage": "c8 mocha",
    "test:e2e": "mocha --config tests/e2e/.mocharc.cjs",
    "test:all": "npm run test:coverage && npm run test:e2e"
  },
  "devDependencies": {
    "@axe-core/puppeteer": "^4.13.0",
    "c8": "^12.0.0",
    "chai": "^5.1.0",
    "http-server": "^14.1.1",
    "mocha": "^10.4.0",
    "puppeteer": "^22.0.0",
    "sinon": "^22.1.0"
  }
}